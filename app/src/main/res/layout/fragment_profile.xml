<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Header area (orange background + profile card overlapping) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp">

                <!-- Orange top rounded panel (use your drawable orange_rounded_vertical) -->
                <View
                    android:id="@+id/orange_panel"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="top"
                    android:background="@drawable/orange_rounded_vertical" />

                <!-- Card that holds profile details -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/header_card"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:padding="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Profile image (circle) -->
                        <ImageView
                            android:id="@+id/ivProfile"
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:src="@drawable/ic_profile_placeholder"
                            android:contentDescription="Profile"
                            android:scaleType="centerCrop"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginTop="-40dp"
                            android:layout_marginStart="14dp"
                            android:padding="4dp" />
                         <!--   android:background="@drawable/circle_white_background" -->


                        <!-- Name / handle -->
                        <TextView
                            android:id="@+id/tvHandle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Kavitha Dissanayake"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            app:layout_constraintStart_toEndOf="@id/ivProfile"
                            app:layout_constraintTop_toTopOf="@id/ivProfile"
                            app:layout_constraintEnd_toStartOf="@+id/ivVerified"
                            android:layout_marginStart="12dp"/>

                        <!-- Small verified badge -->
                        <ImageView
                            android:id="@+id/ivVerified"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check_circle"
                            android:contentDescription="Verified"
                            app:layout_constraintBaseline_toBaselineOf="@id/tvHandle"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="8dp" />

                        <!-- Role and location -->
                        <TextView
                            android:id="@+id/tvRoleLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Worker · Colombo 5"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="@id/tvHandle"
                            app:layout_constraintTop_toBottomOf="@id/tvHandle"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <!-- Rating / Jobs / Member since row -->
                        <LinearLayout
                            android:id="@+id/info_row"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="@id/tvHandle"
                            app:layout_constraintTop_toBottomOf="@id/tvRoleLocation"
                            app:layout_constraintEnd_toEndOf="parent">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginEnd="14dp">
                                <TextView
                                    android:id="@+id/tvRatingLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="★ 4.6"
                                    android:textStyle="bold"
                                    android:textSize="13sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rating"
                                    android:textSize="11sp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginEnd="14dp">
                                <TextView
                                    android:id="@+id/tvJobsCompleted"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="24"
                                    android:textStyle="bold"
                                    android:textSize="13sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Jobs completed"
                                    android:textSize="11sp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvMemberSince"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2021"
                                    android:textStyle="bold"
                                    android:textSize="13sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Member since"
                                    android:textSize="11sp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Edit profile button -->
                        <Button
                            android:id="@+id/btnEditProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Edit profile"
                            android:textAllCaps="false"
                            android:layout_marginTop="6dp"
                            app:layout_constraintTop_toBottomOf="@id/info_row"
                            app:layout_constraintStart_toStartOf="@id/tvHandle"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <!-- Client / Worker toggle group (two buttons) -->
                        <LinearLayout
                            android:id="@+id/toggle_group"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            app:layout_constraintTop_toTopOf="@id/btnEditProfile"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="@id/btnEditProfile">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnClient"
                                android:layout_width="90dp"
                                android:layout_height="match_parent"
                                android:text="Client"
                                android:textAllCaps="false"
                                android:backgroundTint="@android:color/transparent"
                                android:padding="6dp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnWorker"
                                android:layout_width="90dp"
                                android:layout_height="match_parent"
                                android:text="Worker"
                                android:textAllCaps="false"
                                android:padding="6dp" />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- Account Info card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account Info"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kavitha Dissanayake"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:paddingBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+91-8129999999"
                        android:paddingBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="kavitha.d@gmail.com"
                        android:paddingBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Colombo 5"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Verification card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verification"
                android:textStyle="bold"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Awaiting admin review"
                        android:paddingBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ID Parsed DOB · Gender: Female"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Accessibility / UI header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accessibility / UI"
                android:textStyle="bold"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"/>

            <!-- Accessibility Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@null">

                    <!-- Digital proficiency row -->
                    <LinearLayout
                        android:id="@+id/row_digital"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_bar_chart" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="12dp"
                            android:text="Digital proficiency" />

                        <TextView
                            android:id="@+id/tvDigitalTag"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="LOW"
                            android:textAllCaps="true"
                            android:textSize="12sp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:background="@drawable/tag_orange_bg"
                            android:textColor="@android:color/white"
                            android:layout_marginEnd="10dp"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDigital"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_gray"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Voice guidance -->
                    <LinearLayout
                        android:id="@+id/row_voice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_mic" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="12dp"
                            android:text="Voice guidance" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVoice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_gray"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Simplified layout -->
                    <LinearLayout
                        android:id="@+id/row_simplified"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_large_buttons" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="12dp"
                            android:text="Simplified layout (large buttons)" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSimplified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_gray"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Confirm with physical keys (row with chevron) -->
                    <LinearLayout
                        android:id="@+id/row_physical_keys"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_physical_keys" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="12dp"
                            android:text="Confirm with physical keys" />

                        <TextView
                            android:id="@+id/tvPhysicalExample"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="සිංහල  |  தமிழ்"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_gray"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Text size control -->
                    <LinearLayout
                        android:id="@+id/row_text_size"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_text_size" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:text="Text size" />

                        <SeekBar
                            android:id="@+id/sbTextSize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvTextSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.3x"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Add small bottom padding so content isn't cut under nav bars -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
