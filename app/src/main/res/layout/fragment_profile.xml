<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- ORANGE HEADER (draws behind status bar) -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_orange_gradient">

        <!-- Back arrow (left) -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="Back"
            android:scaleType="centerInside" />

        <!-- Profile circle image (centered horizontally, lower so it overlaps white card) -->
        <de.hdodenhof.circleimageview.CircleImageView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/profile_image_main"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="56dp"
            android:src="@drawable/photo_placeholder"
            app:civ_border_width="2dp"
            app:civ_border_color="#FFFFFFFF"
            tools:ignore="MissingClass" />

        <!-- Username + verified badge (centered below image) -->
        <LinearLayout
            android:id="@+id/username_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/profile_image_main"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sample_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/verified_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_verified"
                android:contentDescription="verified" />
        </LinearLayout>

        <!-- subtitle -->
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/username_row"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:text="Worker · Colombo 5"
            android:textColor="#FFF2F2"
            android:textSize="13sp" />

        <!-- small info card (rating | jobs completed | member since) - center below subtitle -->
        <LinearLayout
            android:id="@+id/info_card"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/info_card_bg"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <!-- Rating -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.6"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <!-- Jobs completed -->
            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:background="#e6e6e6" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/jobs_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jobs completed"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:background="#e6e6e6" />

            <!-- Member since -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/member_since_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2021"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Member since"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!-- SCROLLING CONTENT (white rounded panel overlaps the orange header) -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="0dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- spacer to push white container up and overlap the header -->
            <View
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <!-- WHITE PANEL (main content) -->
            <LinearLayout
                android:id="@+id/white_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="-64dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:paddingTop="80dp"
                android:paddingBottom="16dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:background="@drawable/white_card_top_rounded"
                android:elevation="6dp">

            <!-- Edit profile button (centered) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="-72dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="220dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_edit_bg"
                    android:text="Edit profile"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Account Info section -->
            <TextView
                android:id="@+id/section_account_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Info"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Row: Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_person"
                    android:contentDescription="name icon" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Kavitha Dissanayake"
                    android:textSize="14sp"
                    android:textColor="#222222" />
            </LinearLayout>

            <!-- Row: Phone (with lock icon) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_phone"
                    android:contentDescription="phone" />

                <TextView
                    android:id="@+id/tv_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="+91-8129999999"
                    android:textSize="14sp"
                    android:textColor="#222222" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="locked" />
            </LinearLayout>

            <!-- Row: Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_email"
                    android:contentDescription="email" />

                <TextView
                    android:id="@+id/tv_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="kavitha.d@appsnipp.com"
                    android:textSize="14sp"
                    android:textColor="#222222" />
            </LinearLayout>

            <!-- Row: Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="location" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Colombo 5"
                    android:textSize="14sp"
                    android:textColor="#222222" />
            </LinearLayout>

            <!-- Verification section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:padding="10dp"
                android:background="@drawable/verification_card_bg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_height="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verification"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Awaiting admin review"
                        android:textSize="13sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <!-- Pending pill -->
                <TextView
                    android:id="@+id/tv_pending"
                    android:layout_width="78dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="⏱ Pending"
                    android:textSize="13sp"
                    android:background="@drawable/pending_pill_bg"
                    android:textColor="#6B4B00"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Verification details (icons + values) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">

                <!-- Left column icons -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_height="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_id"
                            android:contentDescription="ID parsed" />

                        <TextView
                            android:layout_marginStart="8dp"
                            android:text="ID Parsed DOB"
                            android:textSize="13sp"
                            android:textColor="#444444"
                            android:layout_height="1dp"
                            android:layout_width="1dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_match"
                            android:contentDescription="data match" />

                        <TextView
                            android:layout_marginStart="8dp"
                            android:text="ID data match:"
                            android:textSize="13sp"
                            android:textColor="#444444"
                            android:layout_height="1dp"
                            android:layout_width="1dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_audio"
                            android:contentDescription="voice" />

                        <TextView
                            android:layout_marginStart="8dp"
                            android:text="Yes (Auto-Matched)"
                            android:textSize="13sp"
                            android:textColor="#444444"
                            android:layout_height="1dp"
                            android:layout_width="1dp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Right column small values -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender: Female"
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes (Auto-Matched)"
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Given v1.0"
                        android:textSize="13sp"
                        android:textColor="#444444"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Mopping demo thumbnail -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:background="#FFF9F9"
                android:elevation="1dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:src="@drawable/photo_placeholder"
                    android:contentDescription="demo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mopping demo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.3 x"
                        android:textSize="13sp"
                        android:textColor="#777777" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View details"
                    android:textColor="#6E49D6"
                    android:textSize="14sp"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- Accessibility / UI section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accessibility / UI"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- Digital proficiency row with "LOW" badge and a toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digital proficiency"
                        android:textSize="14sp"
                        android:textColor="#333333"/>

                </LinearLayout>

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="LOW"
                    android:textSize="12sp"
                    android:background="@drawable/low_badge_bg"
                    android:textColor="#FF6B00"
                    android:padding="4dp" />

                <Switch
                    android:id="@+id/switch_digital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Voice guidance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice guidance"
                        android:textSize="14sp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_voice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Simplified layout toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simplified layout (large buttons)"
                        android:textSize="14sp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <Switch
                    android:id="@+id/switch_simple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Confirm with physical keys row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirm with physical keys"
                        android:textSize="14sp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="සිංහල  தமிழ்"
                    android:textSize="14sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <!-- Text size slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text size"
                    android:textSize="14sp"
                    android:textColor="#333333" />

                <SeekBar
                    android:id="@+id/seek_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="13" />

                <TextView
                    android:id="@+id/tv_text_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.3x"
                    android:layout_gravity="end"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- bottom spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>

    </FrameLayout>
