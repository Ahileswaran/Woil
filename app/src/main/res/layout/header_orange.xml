<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Orange panel — base height increased at runtime by statusBar inset -->
    <View
        android:id="@+id/orange_panel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_base_height"
        android:background="@drawable/orange_rounded_vertical"
        android:layout_gravity="top" />

    <!-- White card overlapping the orange area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_card_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:padding="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">

        <!-- Put your header content here -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome 👋\nLooking for a Job?"
            android:textSize="20sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
