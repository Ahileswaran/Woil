<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F7FB"
    android:paddingBottom="10dp">

    <!-- TOP AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp">

        <!-- Softer orange background under status bar -->
        <View
            android:id="@+id/header_bg"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:background="@drawable/bg_orange_gradient" />

        <!-- Medium-style profile card adapted for LOW UI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="#E8D4C3"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/low_profile_soft_orange_bg"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/low_circle_white_ring"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/low_profile_pic"
                    android:contentDescription="@string/cd_profile" />

                <LinearLayout
                    android:id="@+id/ll_name_block"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/profile_image"
                    android:layout_toEndOf="@id/profile_image"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kavitha_kanthasawamy"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tv_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/worker"
                        android:textColor="#FFF3D6"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Quick info boxes -->
                <GridLayout
                    android:id="@+id/grid_quick_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:columnOrderPreserved="false">

                    <TextView
                        android:id="@+id/box_wage"
                        android:layout_width="86dp"
                        android:layout_height="54dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:background="#FFF3EA"
                        android:text="@string/wage_lkr_2600"
                        android:textColor="#7C3B12"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/box_job_done"
                        android:layout_width="86dp"
                        android:layout_height="54dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:background="#FFF3EA"
                        android:text="@string/done_12"
                        android:textColor="#7C3B12"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/box_next"
                        android:layout_width="86dp"
                        android:layout_height="54dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:background="#FFF3EA"
                        android:text="@string/next_cleaning"
                        android:textColor="#7C3B12"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/box_find"
                        android:layout_width="86dp"
                        android:layout_height="54dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:background="#FFF3EA"
                        android:text="@string/alerts_3"
                        android:textColor="#7C3B12"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </GridLayout>

                <ImageButton
                    android:id="@+id/btn_panic"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/grid_quick_info"
                    android:background="@drawable/low_panic_button"
                    android:scaleType="centerInside"
                    android:src="@drawable/low_ic_panic"
                    android:contentDescription="@string/cd_panic" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- JOB ALERTS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/job_alerts"
            android:textColor="#163A63"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="154dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    app:cardBackgroundColor="#EEF5FF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#D5E6FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/maid_work_near_jaffna"
                            android:textColor="#163A63"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/rs_1800"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <Button
                            android:id="@+id/btn_call_alert1"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="#22C55E"
                            android:text="@string/call"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="154dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    app:cardBackgroundColor="#EEF5FF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#D5E6FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cleaning_near_colombo"
                            android:textColor="#163A63"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/hint_rs_1500"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <Button
                            android:id="@+id/btn_call_alert2"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="#22C55E"
                            android:text="@string/call"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="154dp"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#EEF5FF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#D5E6FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/care_taker_near_colombo"
                            android:textColor="#163A63"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/rs_3500"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <Button
                            android:id="@+id/btn_call_alert3"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="#22C55E"
                            android:text="@string/call"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- LOWER TWO HIGHLIGHTED PANELS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Calculator -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#FFF7E8"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#F4D9A6"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calculator"
                        android:textColor="#6D4C0D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/balance_rs_2600"
                        android:textColor="#C2410C"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <Spinner
                        android:id="@+id/spinner_jobtype"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/low_rounded_input" />

                    <EditText
                        android:id="@+id/et_hours"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/low_rounded_input"
                        android:hint="@string/hint_hours"
                        android:inputType="number"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />

                    <EditText
                        android:id="@+id/et_distance"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/low_rounded_input"
                        android:hint="@string/hint_distance"
                        android:inputType="numberDecimal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />

                    <Button
                        android:id="@+id/btn_calculate"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#F59E0B"
                        android:text="@string/calculate"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Woil Guard -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardBackgroundColor="#EEF8F1"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#CFE8D7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/woil_guard"
                        android:textColor="#14532D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/status_safe"
                        android:textColor="#15803D"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/battery_82"
                        android:textColor="#202020"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/incident_none"
                        android:textColor="#202020"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/connected"
                        android:textColor="#202020"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating bottom actions -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="10dp"
            app:strokeColor="#EAEAEA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_phone"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/low_bottom_round_button"
                        android:backgroundTint="#EAF1FF"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_phone"
                        android:contentDescription="@string/cd_phone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/call"
                        android:textColor="#4B5B7C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_message"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/low_bottom_round_button"
                        android:backgroundTint="#EAF1FF"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_message"
                        android:contentDescription="@string/cd_message" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_chat"
                        android:textColor="#4B5B7C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_video"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/low_bottom_round_button"
                        android:backgroundTint="#EAF1FF"
                        android:scaleType="centerInside"
                        android:src="@drawable/low_ic_video"
                        android:contentDescription="@string/cd_video" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/video"
                        android:textColor="#4B5B7C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</LinearLayout>