<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ORANGE HEADER -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_orange_gradient"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">


        <!-- Profile + Info card sits visually overlapping header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="-40dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <!-- Circular profile image -->
                <FrameLayout
                    android:id="@+id/profile_frame"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/low_profile_pic"
                        android:scaleType="centerCrop"
                        android:background="@drawable/low_circle_white_ring"
                        android:padding="4dp"
                        android:contentDescription="profile" />
                </FrameLayout>

                <!-- Name and role -->
                <LinearLayout
                    android:id="@+id/name_block"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/profile_frame"
                    android:layout_marginStart="12dp"
                    android:layout_alignTop="@id/profile_frame">

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kavitha\nKanthasawamy"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tv_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Worker"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFD500"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Right-side info card inside profile -->
                <LinearLayout
                    android:id="@+id/right_info_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/name_block"
                    android:padding="8dp">

                    <View
                        android:layout_width="220dp"
                        android:layout_height="120dp"
                        android:background="@drawable/low_info_panel_bg"
                        android:padding="8dp"/>

                    <!-- We'll overlay a red PANIC button on top using absolute positioning -->
                    <ImageButton
                        android:id="@+id/btn_panic"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:src="@drawable/low_ic_panic"
                        android:scaleType="centerInside"
                        android:background="@drawable/low_panic_button"
                        android:layout_marginTop="-86dp"
                        android:layout_marginEnd="8dp"
                        android:layout_gravity="end" />
                </LinearLayout>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/scroll_wage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="120dp"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Job Alerts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/icon_jobs"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:src="@drawable/low_ic_jobs"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/low_rounded_gray_card"
                    android:padding="12dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="# Maid work Near Jaffna - Wage 1800.00 Rupee"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_call_alert1"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="end"
                        android:background="@drawable/low_green_call_button"
                        android:text="Call the Client"
                        android:textAllCaps="false"
                        android:textColor="#004d00"/>

                    <View android:layout_width="match_parent" android:layout_height="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="# Cleaning work Near Colombo - Wage 1500.00 Rupee"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_call_alert2"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="end"
                        android:background="@drawable/low_green_call_button"
                        android:text="Call the Client"
                        android:textAllCaps="false"
                        android:textColor="#004d00"/>

                    <View android:layout_width="match_parent" android:layout_height="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="# Care taker work Near Colombo - Wage 3500.00 Rupee"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_call_alert3"
                        android:layout_width="120dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="end"
                        android:background="@drawable/low_green_call_button"
                        android:text="Call the Client"
                        android:textAllCaps="false"
                        android:textColor="#004d00"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Wage Calculator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <ImageView
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:src="@drawable/ic_wallet"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/low_rounded_gray_card"
                    android:padding="12dp"
                    android:layout_marginStart="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Wage Balance: 2600.00"
                            android:textColor="#D32F2F"
                            android:textStyle="bold"
                            android:textSize="16sp" android:layout_height="8dp" android:layout_width="8dp"/>

                        <TextView
                            android:layout_marginTop="6dp"
                            android:text="Ongoing Work: None"
                            android:textColor="#1E88E5"
                            android:textStyle="bold" android:layout_height="8dp" android:layout_width="8dp"/>

                        <TextView
                            android:layout_marginTop="6dp"
                            android:text="Previous Work Wage: 1200.00"
                            android:textColor="#8E24AA"
                            android:textStyle="bold" android:layout_height="8dp" android:layout_width="8dp"/>

                        <TextView
                            android:layout_marginTop="6dp"
                            android:text="Timing: 120.00"
                            android:textColor="#43A047"
                            android:textStyle="bold" android:layout_height="8dp" android:layout_width="8dp"/>

                        <TextView
                            android:layout_marginTop="6dp"
                            android:text="Satisfied: 150.00"
                            android:textColor="#FF9800"
                            android:textStyle="bold" android:layout_height="8dp" android:layout_width="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="120dp"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <Spinner
                            android:id="@+id/spinner_jobtype"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:background="@drawable/low_rounded_input"/>

                        <EditText
                            android:id="@+id/et_hours"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Hours"
                            android:background="@drawable/low_rounded_input"
                            android:inputType="number" />

                        <EditText
                            android:id="@+id/et_distance"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter Distances"
                            android:background="@drawable/low_rounded_input"
                            android:inputType="number" />

                        <Button
                            android:id="@+id/btn_calculate"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="Calculate"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/low_pill_button"
                            android:textAllCaps="false"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Woil Guard (safety) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="100dp">

                <ImageView
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:src="@drawable/low_ic_shield"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/low_rounded_gray_card"
                    android:padding="12dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warning : None"
                        android:textColor="#D32F2F"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_marginTop="8dp"
                        android:text="Previous Incidents : Fell from steps"
                        android:textColor="#D32F2F"
                        android:textStyle="bold" android:layout_height="8dp" android:layout_width="8dp"/>

                    <TextView
                        android:layout_marginTop="8dp"
                        android:text="Core Control Resolution : Covering the medical cost by client"
                        android:textColor="#D32F2F"
                        android:textStyle="bold" android:layout_height="8dp" android:layout_width="8dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation floating bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:padding="18dp"
        android:background="@drawable/bottom_nav_bg">

        <ImageButton
            android:id="@+id/btn_phone"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_phone"
            android:background="@drawable/low_bottom_round_button"
            android:scaleType="centerInside"/>

        <Space android:layout_width="36dp" android:layout_height="match_parent"/>

        <ImageButton
            android:id="@+id/btn_message"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_message"
            android:background="@drawable/low_bottom_round_button"
            android:scaleType="centerInside"/>

        <Space android:layout_width="36dp" android:layout_height="match_parent"/>

        <ImageButton
            android:id="@+id/btn_video"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/low_ic_video"
            android:background="@drawable/low_bottom_round_button"
            android:scaleType="centerInside"/>
    </LinearLayout>

</FrameLayout>