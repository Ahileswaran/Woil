<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ORANGE HEADER -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/bg_orange_gradient">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:layout_alignParentStart="true"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post a Job"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"/>
    </RelativeLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- Card container with rounded background like screenshot -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                android:layout_marginTop="8dp"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Job title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_chef"
                            android:contentDescription="job icon"
                            app:tint="#37474F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="   Job title"
                            android:textSize="15sp"
                            android:textColor="#37474F"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_field"
                        android:paddingStart="14dp"
                        android:gravity="center_vertical"
                        android:text="Cooking and Cleaning"
                        android:textColor="#9E9E9E"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Category -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_category"
                            app:tint="#37474F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="   Category"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#37474F"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/ic_color_dot" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Housekeeping"
                            android:textSize="15sp"
                            android:layout_marginStart="12dp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#B0BEC5" />
                    </LinearLayout>

                    <!-- LOCATION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#37474F" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="   Location"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#37474F"/>

                        <TextView
                            android:id="@+id/tv_set_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set location"
                            android:textColor="#7B1FA2"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Map preview -->
                    <ImageView
                        android:id="@+id/img_map"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_map_placeholder"
                        android:background="@drawable/bg_map_card"
                        android:contentDescription="map"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Colombo 5"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp"/>

                    <!-- DATE & TIME -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="#37474F" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="   Date and Time"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#37474F"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_field"
                                android:text="  Apri 26, 2024"
                                android:gravity="center_vertical"
                                android:textSize="14sp"
                                android:textColor="#616161"
                                android:paddingStart="12dp"/>

                            <View
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_field"
                                android:text="  02:00 PM - 4:30 PM"
                                android:gravity="center_vertical"
                                android:textSize="14sp"
                                android:textColor="#616161"
                                android:paddingStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- WAGE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_wallet"
                                app:tint="#37474F" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="   Wage"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#37474F"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_field"
                                android:text="  Rs. 1500"
                                android:gravity="center_vertical"
                                android:textSize="14sp"
                                android:textColor="#616161"
                                android:paddingStart="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_purple"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:text="Rs. 1200 - 1800/hr"
                                android:textSize="12sp"
                                android:textColor="#6A1B9A"
                                android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Allow offers -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_offer"
                            app:tint="#37474F" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="   Allow offers"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#37474F"/>

                        <Switch
                            android:id="@+id/switch_allow_offers"
                            android:layout_width="56dp"
                            android:layout_height="32dp"
                            android:checked="true"/>
                    </LinearLayout>

                    <!-- Job description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Job description"
                        android:textSize="13sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/et_description"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/bg_field"
                        android:padding="12dp"
                        android:gravity="top"
                        android:hint=""
                        android:textColor="#424242"
                        android:textSize="14sp"/>

                    <!-- Spacer before button -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="18dp"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Post Job Button -->
            <Button
                android:id="@+id/btn_post_job"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_post_button_gradient"
                android:text="Post Job"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"
                android:padding="8dp"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>