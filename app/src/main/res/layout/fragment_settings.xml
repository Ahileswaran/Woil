<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_wage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header with overlay button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <!-- Top orange curvy header background -->
            <View
                android:id="@+id/orange_panel"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:background="@drawable/orange_rounded_vertical" />

            <!-- Arrow Button  -->
            <ImageButton
                android:id="@+id/btn_back_arrow_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_gravity="start|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back" />  <!-- provide this drawable -->


            <!-- Title -->
            <TextView
                android:id="@+id/settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="72dp"
                android:layout_marginTop="12dp"
                android:text="Settings"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Cards list (Profile, System Settings, etc.) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="-48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            android:padding="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/profile_image_desc" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kavitha Dissanayake"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Worker · Colombo 5"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Options list: create as separate rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <!-- Profile -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ic_profile"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_profile_orange"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tv_profile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textSize="16sp"
                        android:layout_toEndOf="@id/ic_profile"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_right"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- System Settings -->
            <!-- System Settings (updated to be expandable and include theme toggle) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_system_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <!-- Use vertical layout so we can collapse/expand the second row -->
                <LinearLayout
                    android:id="@+id/system_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Main Row -->
                    <RelativeLayout
                        android:id="@+id/system_main_row"
                        android:layout_width="match_parent"
                        android:layout_height="64dp">

                        <ImageView
                            android:id="@+id/ic_system"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_system_blue"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true" />

                        <TextView
                            android:id="@+id/tv_system"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Settings"
                            android:textSize="16sp"
                            android:layout_toEndOf="@id/ic_system"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"/>

                        <ImageView
                            android:id="@+id/ic_system_chevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"/>
                    </RelativeLayout>

                    <!-- Expandable content (initially GONE) -->
                    <LinearLayout
                        android:id="@+id/system_expandable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="App theme"
                            android:textSize="16sp"
                            android:layout_weight="1"/>

                        <!-- Material switch for dark/light toggle -->
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_theme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Woil Guard Settings -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ic_guard"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_guard_green"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tv_guard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Woil Guard Settings"
                        android:textSize="16sp"
                        android:layout_toEndOf="@id/ic_guard"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_right"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Privacy & Terms -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ic_privacy"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_privacy_purple"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tv_privacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy and Terms"
                        android:textSize="16sp"
                        android:layout_toEndOf="@id/ic_privacy"
                        android:layout_marginStart="12dp"
                        android:layout_centerVertical="true"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_right"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- filler to push content up when not scrolling -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

    </LinearLayout>
</ScrollView>
