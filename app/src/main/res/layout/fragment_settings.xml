<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ORANGE HEADER -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_orange_gradient">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_white"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="28dp"/>
    </RelativeLayout>


    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/scroll_wage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:padding="16dp">

            </com.google.android.material.card.MaterialCardView>


            <!-- Options Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Profile -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    android:padding="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ic_profile"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_profile_orange"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true" />

                        <TextView
                            android:id="@+id/tv_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profile"
                            android:textSize="16sp"
                            android:layout_toEndOf="@id/ic_profile"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- ===== New: System UI Selection (toggle group) ===== -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_system_ui_selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/system_ui_main_row"
                            android:layout_width="match_parent"
                            android:layout_height="64dp">

                            <ImageView
                                android:id="@+id/ic_system_ui"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_system_blue"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System UI Selection"
                                android:textSize="16sp"
                                android:layout_toEndOf="@id/ic_system_ui"
                                android:layout_marginStart="12dp"
                                android:layout_centerVertical="true"/>

                            <ImageView
                                android:id="@+id/ic_system_ui_chevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_chevron_right"/>
                        </RelativeLayout>

                        <!-- Expandable: System UI Selection -->
                        <LinearLayout
                            android:id="@+id/system_ui_expandable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Choose UI density"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp"/>

                            <!-- Material single-selection toggle group (acts like mutually-exclusive toggles) -->
                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/system_ui_toggle_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:singleSelection="true"
                                app:selectionRequired="true"
                                android:layout_marginBottom="4dp"
                                android:padding="4dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_ui_high"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="High Level UI\n(Default)"
                                    android:checked="true"
                                    android:gravity="center"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp"
                                    android:contentDescription="High level user interface (default)"/>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_ui_medium"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Medium Level UI"
                                    android:gravity="center"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp"
                                    android:contentDescription="Medium level user interface"/>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_ui_low"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Low Level UI"
                                    android:gravity="center"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp"
                                    android:contentDescription="Low level user interface"/>

                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <!-- Optional short description / hint -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="High = richer controls; Medium = balanced; Low = compact/simple."
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- System Settings (original theme selection card) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_system_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/system_main_row"
                            android:layout_width="match_parent"
                            android:layout_height="64dp">

                            <ImageView
                                android:id="@+id/ic_system"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_system_blue"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System Settings"
                                android:textSize="16sp"
                                android:layout_toEndOf="@id/ic_system"
                                android:layout_marginStart="12dp"
                                android:layout_centerVertical="true"/>

                            <ImageView
                                android:id="@+id/ic_system_chevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_chevron_right"/>
                        </RelativeLayout>

                        <!-- Expandable -->
                        <LinearLayout
                            android:id="@+id/system_expandable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="App theme"
                                android:textSize="16sp"
                                android:layout_weight="1"/>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_theme"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Woil Guard Settings -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    android:padding="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ic_guard"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_guard_green"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true" />

                        <TextView
                            android:id="@+id/tv_guard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Woil Guard Settings"
                            android:textSize="16sp"
                            android:layout_toEndOf="@id/ic_guard"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Privacy -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    android:padding="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ic_privacy"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_privacy_purple"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true" />

                        <TextView
                            android:id="@+id/tv_privacy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Privacy and Terms"
                            android:textSize="16sp"
                            android:layout_toEndOf="@id/ic_privacy"
                            android:layout_marginStart="12dp"
                            android:layout_centerVertical="true"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>