<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Remote Video Renderer (Full Screen) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Local Video Renderer (Picture-in-Picture) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/local_view_container"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/transparent">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- Caller/Receiver Info (Centered when connecting) -->
    <LinearLayout
        android:id="@+id/layout_calling_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_call_user_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/photo_placeholder"
            app:civ_border_color="@android:color/white"
            app:civ_border_width="2dp" />

        <TextView
            android:id="@+id/tv_call_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Connecting..."
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calling..."
            android:textColor="#CCCCCC"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bottom Controls Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Toggle Video -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_toggle_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:backgroundTint="#424242"
            app:tint="@android:color/white"
            app:srcCompat="@drawable/ic_video_white" />

        <!-- Mute Audio -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_toggle_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:backgroundTint="#424242"
            app:tint="@android:color/white"
            app:srcCompat="@drawable/ic_mic_white" />

        <!-- Switch Camera -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:backgroundTint="#424242"
            app:tint="@android:color/white"
            app:srcCompat="@drawable/ic_switch_camera" />

        <!-- Toggle Speaker -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_toggle_speaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:backgroundTint="#424242"
            app:tint="@android:color/white"
            app:srcCompat="@drawable/ic_speaker" />

        <!-- Accept Call (Green, visible only for incoming calls before connection) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_accept_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:backgroundTint="#4CAF50"
            app:tint="@android:color/white"
            app:srcCompat="@drawable/ic_call_white"
            android:visibility="gone" />

        <!-- End Call -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_end_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:backgroundTint="#E53935"
            app:tint="@android:color/white"
            app:srcCompat="@drawable/ic_call_end_white" />
    </LinearLayout>
</FrameLayout>
