<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Top header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/orange_panel"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/orange_rounded_vertical" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_gravity="bottom"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="383dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="Woil logo"
                            android:src="@drawable/woil" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Set up your profile"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- Form card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- First Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Name"
                        android:textSize="13sp"/>
                    <EditText
                        android:id="@+id/etFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter First Name eg: Kumaran"
                        android:padding="10dp"
                        android:background="@android:color/darker_gray"
                        android:textColor="@android:color/black"
                        android:layout_marginTop="6dp"/>

                    <!-- Last Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Last Name"
                        android:textSize="13sp"/>
                    <EditText
                        android:id="@+id/etLastName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter Last Name eg: Selliyah"
                        android:padding="10dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginTop="6dp"/>

                    <!-- Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Address"
                        android:textSize="13sp"/>
                    <EditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter your address eg: Colombo 5"
                        android:padding="10dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tvSelectLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Location on the Map"
                        android:textColor="@color/purple_500"
                        android:layout_marginTop="8dp"/>

                    <!-- NIC verification -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="NIC Verification (Optional)"
                        android:textSize="13sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etNic"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="[95xxxxxxxxV________]"
                            android:padding="10dp"
                            android:background="@android:color/darker_gray"/>

                        <ImageButton
                            android:id="@+id/btnUploadNic"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Upload NIC"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSkipNic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[Skip for now]"
                        android:textColor="@color/purple_500"
                        android:layout_marginTop="6dp"/>

                    <!-- Gender -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Gender"
                        android:textSize="13sp"/>

                    <RadioGroup
                        android:id="@+id/rgGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Male"/>

                        <RadioButton
                            android:id="@+id/rbFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Female"
                            android:layout_marginStart="18dp"/>
                    </RadioGroup>

                    <!-- Date of Birth -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Date of Birth"
                        android:textSize="13sp"/>

                    <EditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Enter your date of birth : day/ month/ year"
                        android:focusable="false"
                        android:clickable="true"
                        android:padding="10dp"
                        android:background="@android:color/darker_gray"
                        android:layout_marginTop="6dp"/>

                    <!-- Skills (Workers only) -->
                    <TextView
                        android:id="@+id/tvSkillsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Skills (Workers Only)"
                        android:textSize="13sp"/>

                    <Spinner
                        android:id="@+id/spinnerSkills"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"/>

                    <!-- Submit button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitProfile"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:layout_marginTop="16dp"
                        android:padding="10dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
