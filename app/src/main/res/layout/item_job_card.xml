<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    android:layout_marginBottom="12dp"
    android:padding="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row: title + wage badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_job_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/job_title_2"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#263238"/>

            <TextView
                android:id="@+id/tv_wage_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_purple"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/rs_1200_hr"
                android:textSize="12sp"
                android:textColor="#6A1B9A"/>
        </LinearLayout>

        <!-- Location -->
        <TextView
            android:id="@+id/tv_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/colombo_5"
            android:textSize="14sp"
            android:textColor="#455A64"
            android:layout_marginTop="6dp"/>

        <!-- Date/time -->
        <TextView
            android:id="@+id/tv_time_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apr_26_2024_02_00_pm_04_30_pm"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>