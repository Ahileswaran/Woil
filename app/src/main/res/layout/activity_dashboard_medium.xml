<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ORANGE HEADER (full-width gradient) -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/medium_bg_orange_gradient" />

    <!-- MAIN CONTENT — overlaps the header by using marginTop -->
    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==== Profile Card (medium) ==== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:padding="0dp">

                <!-- large orange panel inside card -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/medium_info_panel_bg"
                    android:padding="16dp">

                    <!-- circular avatar on left -->
                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:src="@drawable/medium_profile_icon"
                        android:scaleType="centerInside"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/medium_circle_white_ring"
                        android:padding="8dp" />

                    <!-- name & role -->
                    <LinearLayout
                        android:id="@+id/ll_name_block"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/iv_avatar"
                        android:layout_marginStart="12dp"
                        android:layout_alignTop="@id/iv_avatar">

                        <TextView
                            android:id="@+id/tv_name_medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kavitha Kanthasawamy"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_role_medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Worker"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- quick info grid (4 boxes) -->
                    <GridLayout
                        android:id="@+id/grid_quick_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="8dp"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:columnOrderPreserved="false">

                        <TextView
                            android:id="@+id/box_wage"
                            style="@style/Widget.MediumQuickBox"
                            android:text="Wage Balance\nLKR 2600.00" />

                        <TextView
                            android:id="@+id/box_job_done"
                            style="@style/Widget.MediumQuickBox"
                            android:text="Job Done\n12" />

                        <TextView
                            android:id="@+id/box_next"
                            style="@style/Widget.MediumQuickBox"
                            android:text="Next Job\nCleaning" />

                        <TextView
                            android:id="@+id/box_find"
                            style="@style/Widget.MediumQuickBox"
                            android:text="Find Job\n●" />
                    </GridLayout>

                    <!-- panic btn (floating) -->
                    <ImageButton
                        android:id="@+id/btn_panic_medium"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="12dp"
                        android:layout_toStartOf="@id/grid_quick_info"
                        android:background="@drawable/medium_panic_button"
                        android:src="@drawable/medium_ic_panic"
                        android:scaleType="centerInside"/>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Accordion Sections ===== -->
            <!-- Each header has an id header_xxx and the hidden content is content_xxx (visibility gone) -->

            <!-- 1) User Profile Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_user_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- header -->
                    <LinearLayout
                        android:id="@+id/header_user_profile"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:onClick="onSectionHeaderClick">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/medium_ic_user"
                            android:contentDescription="icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="User Profile"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"/>

                        <ImageView
                            android:id="@+id/chev_user_profile"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <!-- hidden content -->
                    <LinearLayout
                        android:id="@+id/content_user_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <!-- Example expanded content -->
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Profile details, contact info, last jobs and settings go here."
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2) Job Alerts -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_job_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_job_alerts"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:onClick="onSectionHeaderClick">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/medium_ic_jobs" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Job Alerts"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"/>

                        <ImageView
                            android:id="@+id/chev_job_alerts"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_job_alerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <!-- Sample list of alerts (replace with RecyclerView later) -->
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="• Maid work Near Jaffna — LKR 1800\n• Cleaning Near Colombo — LKR 1500"
                            android:textSize="14sp" />
                        <Button android:id="@+id/btn_call_alerts" android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Call the Client"
                            android:background="@drawable/medium_green_call_button"
                            android:textAllCaps="false"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3) Wage Calculator -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_wage_calc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_wage_calc"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:onClick="onSectionHeaderClick">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/medium_ic_wallet" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Wage Calculator"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"/>

                        <ImageView
                            android:id="@+id/chev_wage_calc"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_wage_calc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Wage Balance: LKR 2600.00" android:textSize="14sp"/>
                        <Spinner android:id="@+id/spinner_medium_jobtype" android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/medium_rounded_input"/>
                        <EditText android:id="@+id/et_medium_hours" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="Enter Hours"
                            android:inputType="number" android:background="@drawable/medium_rounded_input"
                            android:layout_marginTop="8dp"/>
                        <Button android:id="@+id/btn_calc_medium" android:layout_width="match_parent"
                            android:layout_height="40dp" android:text="Calculate"
                            android:background="@drawable/medium_pill_button" android:textAllCaps="false"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4) Woil Guard -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_woil_guard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_woil_guard"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:onClick="onSectionHeaderClick">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/medium_ic_shield" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Woil Guard"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"/>

                        <ImageView
                            android:id="@+id/chev_woil_guard"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_woil_guard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Warning: None\nPrevious Incidents: Fell from steps\nResolution: Medical costs covered by client"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation floating bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/medium_bottom_nav_bg">

        <ImageButton
            android:id="@+id/btn_phone"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/medium_ic_phone"
            android:background="@drawable/medium_bottom_round_button"
            android:scaleType="centerInside"/>

        <Space android:layout_width="24dp" android:layout_height="match_parent"/>

        <ImageButton
            android:id="@+id/btn_message"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/medium_ic_message"
            android:background="@drawable/medium_bottom_round_button"
            android:scaleType="centerInside"/>

        <Space android:layout_width="24dp" android:layout_height="match_parent"/>

        <ImageButton
            android:id="@+id/btn_video"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/medium_ic_video"
            android:background="@drawable/medium_bottom_round_button"
            android:scaleType="centerInside"/>
    </LinearLayout>

</FrameLayout>