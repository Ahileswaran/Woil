<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@drawable/medium_bg_orange_gradient" />

    <!-- Main content -->
    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="52dp"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="110dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:strokeColor="#E7D6C8"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:background="@drawable/medium_info_panel_bg"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/medium_circle_white_ring"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/medium_profile_icon" />

                    <LinearLayout
                        android:id="@+id/ll_name_block"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@id/iv_avatar"
                        android:layout_toEndOf="@id/iv_avatar"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_name_medium"
                            android:layout_width="220dp"
                            android:layout_height="wrap_content"
                            android:text="@string/kavitha_kanthasawamy"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tv_role_medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/worker"
                            android:textColor="#FFF3CC"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <GridLayout
                        android:id="@+id/grid_quick_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="8dp"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:columnOrderPreserved="false">

                        <TextView
                            android:id="@+id/box_wage"
                            style="@style/Widget.MediumQuickBox"
                            android:text="@string/wage_nlkr_2600" />

                        <TextView
                            android:id="@+id/box_job_done"
                            style="@style/Widget.MediumQuickBox"
                            android:text="@string/done_n12" />

                        <TextView
                            android:id="@+id/box_next"
                            style="@style/Widget.MediumQuickBox"
                            android:text="@string/next_ncleaning" />

                        <TextView
                            android:id="@+id/box_find"
                            style="@style/Widget.MediumQuickBox"
                            android:text="@string/alerts_n3" />
                    </GridLayout>

                    <ImageButton
                        android:id="@+id/btn_panic_medium"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="12dp"
                        android:layout_toStartOf="@id/grid_quick_info"
                        android:background="@drawable/medium_panic_button"
                        android:scaleType="centerInside"
                        android:src="@drawable/medium_ic_panic"
                        android:contentDescription="@string/cd_panic" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- User Profile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_user_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFF3EA"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#F3D7BF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_user_profile"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/medium_ic_user"
                            android:contentDescription="@string/cd_profile" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/user_profile"
                            android:textColor="#5A2D0C"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <ImageView
                            android:id="@+id/chev_user_profile"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_user_profile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_phone_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/phone_077_xxx_xxxx"
                            android:textColor="#5F3B24"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_area_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/area_colombo"
                            android:textColor="#5F3B24"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Job Alerts -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_job_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#EEF5FF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#D5E6FF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_job_alerts"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/medium_ic_jobs"
                            android:contentDescription="@string/cd_jobs" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/job_alerts"
                            android:textColor="#163A63"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <ImageView
                            android:id="@+id/chev_job_alerts"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_job_alerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/maid_work_near_jaffna"
                                    android:textColor="#163A63"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/rs_1800"
                                    android:textColor="#2563EB"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black" />

                                <Button
                                    android:id="@+id/btn_call_alerts"
                                    android:layout_width="110dp"
                                    android:layout_height="34dp"
                                    android:layout_marginTop="8dp"
                                    android:backgroundTint="#22C55E"
                                    android:text="@string/call"
                                    android:textAllCaps="false"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cleaning_near_colombo"
                                    android:textColor="#163A63"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/hint_rs_1500"
                                    android:textColor="#2563EB"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wage Calculator -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_wage_calc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFF7E8"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#F4D9A6"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_wage_calc"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/medium_ic_wallet"
                            android:contentDescription="@string/cd_wallet" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/wage_calculator"
                            android:textColor="#6D4C0D"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <ImageView
                            android:id="@+id/chev_wage_calc"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_wage_calc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/balance_lkr_2600"
                            android:textColor="#C2410C"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <Spinner
                            android:id="@+id/spinner_medium_jobtype"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/medium_rounded_input" />

                        <EditText
                            android:id="@+id/et_medium_hours"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/medium_rounded_input"
                            android:hint="@string/hint_hours"
                            android:inputType="number"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp" />

                        <Button
                            android:id="@+id/btn_calc_medium"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#F59E0B"
                            android:text="@string/calculate"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Woil Guard -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_woil_guard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#EEF8F1"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#CFE8D7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_woil_guard"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/medium_ic_shield"
                            android:contentDescription="@string/cd_guard" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/woil_guard"
                            android:textColor="#14532D"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <ImageView
                            android:id="@+id/chev_woil_guard"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/medium_ic_chev_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/content_woil_guard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/status_safe"
                            android:textColor="#15803D"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/battery_82"
                            android:textColor="#202020"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/incident_none"
                            android:textColor="#202020"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Floating bottom actions above system nav -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="10dp"
            app:strokeColor="#EAEAEA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_phone"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/medium_bottom_round_button"
                        android:backgroundTint="#EAF1FF"
                        android:scaleType="centerInside"
                        android:src="@drawable/medium_ic_phone"
                        android:contentDescription="@string/cd_phone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/call"
                        android:textColor="#4B5B7C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_message"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/medium_bottom_round_button"
                        android:backgroundTint="#EAF1FF"
                        android:scaleType="centerInside"
                        android:src="@drawable/medium_ic_message"
                        android:contentDescription="@string/cd_message" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_chat"
                        android:textColor="#4B5B7C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btn_video"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/medium_bottom_round_button"
                        android:backgroundTint="#EAF1FF"
                        android:scaleType="centerInside"
                        android:src="@drawable/medium_ic_video"
                        android:contentDescription="@string/cd_video" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/video"
                        android:textColor="#4B5B7C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>