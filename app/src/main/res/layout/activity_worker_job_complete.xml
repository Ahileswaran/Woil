<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <!-- Orange Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_orange_gradient"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Job Complete"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Big checkmark icon -->
        <TextView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="🎉"
            android:textSize="58sp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tv_complete_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Work Done! ✅"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle — waiting state -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Great job! Waiting for the client\nto confirm payment…"
            android:textColor="#888888"
            android:textSize="15sp" />

        <!-- Job title chip -->
        <TextView
            android:id="@+id/tv_complete_job_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_chip_soft_orange"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="Job"
            android:textColor="#FF8A00"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Expected amount (populated if wage known) -->
        <TextView
            android:id="@+id/tv_complete_expected_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#555555"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Animated waiting ring -->
        <ProgressBar
            android:id="@+id/progress_waiting"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            android:indeterminateTint="#FF8A00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Payment notification will appear\nautomatically when client pays"
            android:gravity="center"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Go Home button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go_home"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Go to Home"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FF8A00"
            app:cornerRadius="16dp" />

    </LinearLayout>
</FrameLayout>
