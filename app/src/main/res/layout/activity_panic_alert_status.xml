<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEBEB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_warning"
            app:tint="#D32F2F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PANIC ALERT SENT!"
            android:textColor="#D32F2F"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your emergency contacts have been notified.\nCore Control Center operators are reviewing your case."
            android:textColor="#424242"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/tv_alert_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sending..."
            android:textColor="#757575"
            android:textSize="14sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_ccc_case"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="View CCC Case Status"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_ccc_contacts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="View Emergency Contacts"
            android:textAllCaps="false"
            android:textColor="#D32F2F"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FFEBEB"
            app:strokeColor="#D32F2F"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_back_arrow_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="#D32F2F" />

</RelativeLayout>
