<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".ui.ProfileFragment">

    <!-- ORANGE HEADER (draws behind status bar) -->
    <RelativeLayout
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="206dp"
        android:background="@drawable/bg_orange_gradient">

        <!-- Back -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_white"
            android:layout_alignParentStart="true" />

        <!-- profile circle -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image_main"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:src="@drawable/photo_placeholder"
            app:civ_border_color="#FFFFFFFF"
            app:civ_border_width="2dp"
            tools:ignore="MissingClass" />

        <!-- username + verified -->
        <LinearLayout
            android:id="@+id/username_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/profile_image_main"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RaviKumar Rajes"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/verified_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="verified"
                android:src="@drawable/ic_verified" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/username_row"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:text="Client · Colombo 5"
            android:textColor="#FFF2F2"
            android:textSize="8sp" />

        <!-- info card (rating / jobs posted / member since) -->
        <LinearLayout
            android:id="@+id/info_card"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="138dp"
            android:layout_marginBottom="46dp"
            android:background="@drawable/info_card_bg"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.6"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating"
                    android:textColor="#666666"
                    android:textSize="7sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="#e6e6e6" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/jobs_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jobs Posted"
                    android:textColor="#666666"
                    android:textSize="7sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="#e6e6e6" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/member_since_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Member since"
                    android:textColor="#666666"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- small white container with Edit + toggle (over header) -->
        <LinearLayout
            android:id="@+id/top_white_container"
            android:layout_width="323dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="53dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/white_card_top_rounded"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.6"
                    android:background="@drawable/btn_edit_bg"
                    android:text="Edit profile"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/toggle_group_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <Button
                        android:id="@+id/btn_client"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@android:color/white"
                        android:text="Client"
                        android:textColor="@color/purple_700"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_worker"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/outline_pill_bg"
                        android:text="Worker"
                        android:textColor="@android:color/black"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!-- MAIN CONTENT (client) — compact, overlaps header via marginTop -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="200dp"
        android:clipToPadding="false">

        <!-- Account Info card (same as worker) -->
        <LinearLayout
            android:id="@+id/card_account_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_card_bg"
            android:padding="8dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/section_account_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Info"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <!-- rows -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_person" />
                <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="—" android:textSize="12sp" android:textColor="#222222" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_phone" />
                <TextView android:id="@+id/tv_phone" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="—" android:textSize="12sp" android:textColor="#222222" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp"
                    android:src="@drawable/ic_lock" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_email" />
                <TextView android:id="@+id/tv_email" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="—" android:textSize="12sp" android:textColor="#222222" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#f0f0f0" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_location" />
                <TextView android:id="@+id/tv_location" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="—" android:textSize="12sp" android:textColor="#222222" />
            </LinearLayout>
        </LinearLayout>

        <!-- small gap -->
        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <!-- View your ads card -->
        <LinearLayout
            android:id="@+id/card_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_card_bg"
            android:padding="8dp"
            android:elevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">

                <TextView android:id="@+id/section_ads_title" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="View your ads" android:textSize="14sp" android:textStyle="bold" />

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ads" android:contentDescription="ads" />
            </LinearLayout>

            <!-- horizontal ad list (two items) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:weightSum="2">

                <!-- Ad 1 -->
                <LinearLayout
                    android:id="@+id/ad1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/ad1_image"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:src="@drawable/photo_placeholder"
                        android:scaleType="centerCrop"
                        android:background="@drawable/section_card_bg" />

                    <TextView
                        android:id="@+id/ad1_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="12.05.2025 12:30 Am"
                        android:textSize="10sp"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/ad1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kitchen cleaning"
                        android:textSize="13sp"
                        android:textColor="#222222"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Ad 2 -->
                <LinearLayout
                    android:id="@+id/ad2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/ad2_image"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:src="@drawable/photo_placeholder"
                        android:scaleType="centerCrop"
                        android:background="@drawable/section_card_bg" />

                    <TextView
                        android:id="@+id/ad2_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="09.05.2025 09:30 Am"
                        android:textSize="10sp"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/ad2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Care giving"
                        android:textSize="13sp"
                        android:textColor="#222222"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- small gap -->
        <View android:layout_width="match_parent" android:layout_height="8dp" />

        <!-- Work Progress card -->
        <LinearLayout
            android:id="@+id/card_work_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_card_bg"
            android:padding="8dp"
            android:elevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">

                <TextView android:id="@+id/section_work_title" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Work Progress" android:textSize="14sp" android:textStyle="bold" />

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_progress" android:contentDescription="progress" />
            </LinearLayout>

            <!-- Task 1 -->
            <TextView
                android:id="@+id/wp_task1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kitchen Cleaning"
                android:textSize="13sp"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/wp_task1_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.05.2025 01:45 Am"
                android:textSize="10sp"
                android:textColor="#777777" />

            <!-- horizontal progress (uses ProgressBar) -->
            <ProgressBar
                android:id="@+id/wp_task1_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="60"
                android:indeterminate="false" />

            <!-- Task 2 -->
            <TextView
                android:id="@+id/wp_task2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Care giving"
                android:textSize="13sp"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/wp_task2_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09.05.2025 05:00 Pm"
                android:textSize="10sp"
                android:textColor="#777777" />

            <ProgressBar
                android:id="@+id/wp_task2_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="100"
                android:indeterminate="false" />
        </LinearLayout>

        <!-- Accessibility card (same as worker) -->
        <LinearLayout
            android:id="@+id/card_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/section_card_bg"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:elevation="2dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accessibility / UI" android:textSize="14sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Digital proficiency" android:textSize="13sp" />
                <TextView android:layout_width="44dp" android:layout_height="24dp" android:gravity="center" android:text="LOW" android:textSize="11sp" android:background="@drawable/low_badge_bg" android:textColor="#FF6B00" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_digital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Voice guidance" android:textSize="13sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_voice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Simplified layout (large buttons)" android:textSize="13sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_simple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Text size" android:textSize="13sp" />
                <SeekBar android:id="@+id/seek_text_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30" android:progress="13" />
                <TextView android:id="@+id/tv_text_size_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.3x" android:layout_gravity="end" android:layout_marginTop="4dp" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- bottom spacing -->
        <View android:layout_width="match_parent" android:layout_height="12dp" />
    </LinearLayout>
</FrameLayout>