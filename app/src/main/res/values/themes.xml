<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Woil" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Allow drawing behind system bars -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Make status/navigation bar start transparent so content can be full-screen -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Let content extend into display cutout (notch) area -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- keep NoActionBar parent so there's no ActionBar taking space -->
    </style>
</resources>
