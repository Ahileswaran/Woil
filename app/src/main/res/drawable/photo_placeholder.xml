<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- background rounded rect -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFECECEC"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- simple mountain / avatar vector drawn on top -->
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="8dp">
        <vector android:width="64dp" android:height="48dp" android:viewportWidth="64" android:viewportHeight="48"
            xmlns:android="http://schemas.android.com/apk/res/android">
            <!-- little mountain -->
            <path android:fillColor="#FFCCCCCC" android:pathData="M2,38 L22,12 L36,28 L46,18 L62,38 z"/>
            <!-- small circle avatar / badge in top-left corner -->
            <path android:fillColor="#FFBDBDBD" android:pathData="M12,20a6,6 0 1,0 0.0001,0z"/>
        </vector>
    </item>
</layer-list>
