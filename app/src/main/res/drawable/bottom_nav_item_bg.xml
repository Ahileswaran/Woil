<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- when item is checked, draw the inset circle -->
    <item android:state_checked="true" android:drawable="@drawable/bg_circle_inset"/>
    <!-- default: transparent (no visible background) -->
    <item android:drawable="@color/transparent"/>
</selector>
